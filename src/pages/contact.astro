---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import ContactAside from '../components/sections/ContactAside.astro';
import ContactForm from '../components/forms/ContactForm';
import { getSettings } from '../lib/content';
import { breadcrumbJsonLd } from '../lib/seo';

const settings = getSettings();
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
];
---

<BaseLayout
  title="Contact us"
  description={`Questions, ideas or partnerships: send us a message and we reply ${settings.replyTime}.`}
  headerTone="night"
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site)]}
>
  <PageHero
    breadcrumbs={crumbs}
    eyebrow="Contact"
    title="Let's talk"
    intro="Ask a question, share an idea or tell us about a project. For a detailed quotation, use the quote form instead."
  >
    <p class="rise-in" style="--rise-index:4"><a href="/quote" class="font-medium text-highlight underline underline-offset-4">Request a quote instead →</a></p>
  </PageHero>

  <section class="container-site grid gap-12 py-20 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
    <div class="min-w-0">
      <ContactForm client:load siteKey={siteKey} email={settings.email} replyTime={settings.replyTime} />
      <noscript>
        <p class="mt-4 rounded-xl border border-line p-4">This form needs JavaScript. {settings.email ? `Please email us at ${settings.email}.` : 'Please enable JavaScript to send a message.'}</p>
      </noscript>
    </div>
    <ContactAside />
  </section>
</BaseLayout>
