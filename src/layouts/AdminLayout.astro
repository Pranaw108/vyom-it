---
import '../styles/global.css';
import Icon from '../components/ui/Icon.astro';
import { ROLE_LABELS, type Permission } from '../server/admin/permissions';
import { getSettings } from '../lib/content';

interface Props {
  title: string;
  /** Short description under the title. */
  intro?: string;
}
const { title, intro } = Astro.props;
const admin = Astro.locals.admin!;
const { companyName } = getSettings();
const path = Astro.url.pathname;
const message = Astro.url.searchParams.get('msg');
const error = Astro.url.searchParams.get('err');

type NavIcon = 'layers' | 'message' | 'pen' | 'users' | 'shield' | 'compass' | 'lock';
const nav: { label: string; href: string; icon: NavIcon; permission: Permission }[] = [
  { label: 'Dashboard', href: '/admin', icon: 'compass', permission: 'dashboard.view' },
  { label: 'Leads', href: '/admin/leads', icon: 'message', permission: 'leads.view' },
  { label: 'Content', href: '/admin/content', icon: 'pen', permission: 'content.view' },
  { label: 'Team', href: '/admin/content/team', icon: 'users', permission: 'team.edit' },
  { label: 'Accounts', href: '/admin/users', icon: 'shield', permission: 'users.manage' },
  { label: 'Audit log', href: '/admin/audit', icon: 'layers', permission: 'audit.view' },
  { label: 'Your account', href: '/admin/account', icon: 'lock', permission: 'dashboard.view' },
];
const visible = nav.filter((n) => admin.can(n.permission));
const active = (href: string) =>
  href === '/admin' ? path === '/admin' : path === href || (path.startsWith(`${href}/`) && !(href === '/admin/content' && path.startsWith('/admin/content/team')));
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="csrf-token" content={admin.csrf} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · {companyName} admin</title>
  </head>
  <body class="admin min-h-dvh bg-surface">
    <a href="#admin-main" class="admin-skip">Skip to content</a>
    <div class="grid min-h-dvh grid-cols-1 lg:grid-cols-[248px_minmax(0,1fr)]">
      <aside class="admin-side min-w-0">
        <div class="flex items-center justify-between gap-3 px-5 py-5 lg:block">
          <a href="/admin" class="flex items-center gap-2.5 font-display text-lg font-semibold text-on-night">
            <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#2e5bff" /><path d="M9 10.5 16 23l7-12.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /><circle cx="16" cy="9" r="2.4" fill="#ffb547" /></svg>
            Admin
          </a>
          <a href="/" class="text-sm text-on-night-muted hover:text-on-night lg:mt-1 lg:block">View website ↗</a>
        </div>
        <nav aria-label="Admin" class="admin-nav">
          <ul>
            {visible.map((n) => (
              <li>
                <a href={n.href} class:list={['admin-nav-link', active(n.href) && 'is-active']} aria-current={active(n.href) ? 'page' : undefined}>
                  <Icon name={n.icon} size={18} />
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="mt-auto hidden border-t border-white/10 px-5 py-4 text-sm lg:block">
          <p class="font-medium text-on-night">{admin.user.name}</p>
          <p class="text-on-night-muted"><span class="font-mono">{admin.user.username}</span> · {ROLE_LABELS[admin.user.role]}</p>
          <a href="/auth/logout" class="mt-2 inline-block text-on-night-muted underline underline-offset-4 hover:text-on-night">Sign out</a>
        </div>
      </aside>

      <main id="admin-main" tabindex="-1" class="min-w-0 px-[max(16px,env(safe-area-inset-left))] py-8 lg:px-10">
        <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div class="flex flex-col gap-1">
            <h1 class="text-3xl font-semibold">{title}</h1>
            {intro && <p class="text-muted">{intro}</p>}
          </div>
          <slot name="actions" />
        </header>
        {message && <p class="admin-flash admin-flash--ok" role="status">{message}</p>}
        {error && <p class="admin-flash admin-flash--error" role="alert">{error}</p>}
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  .admin-skip { position: fixed; left: 1rem; top: -4rem; z-index: 60; padding: 0.6rem 1rem; border-radius: 0.6rem; background: var(--accent); color: var(--on-accent); }
  .admin-skip:focus { top: 1rem; }
  #admin-main:focus { outline: none; }
  .admin-side { display: flex; flex-direction: column; background: var(--night); color: var(--on-night); }
  @media (min-width: 1024px) { .admin-side { position: sticky; top: 0; height: 100dvh; } }
  .admin-nav { padding: 0 0.75rem 0.75rem; overflow-x: auto; }
  .admin-nav ul { display: flex; gap: 0.25rem; }
  @media (min-width: 1024px) { .admin-nav ul { flex-direction: column; } }
  .admin-nav-link {
    display: flex; align-items: center; gap: 0.65rem; white-space: nowrap; padding: 0.6rem 0.85rem; border-radius: 0.65rem;
    color: var(--on-night-muted); font-weight: 500; font-size: 0.95rem; transition: background-color 150ms, color 150ms;
  }
  .admin-nav-link:hover { background: rgb(255 255 255 / 0.06); color: var(--on-night); }
  /* Active item: a soft glow that reads in both themes. */
  .admin-nav-link.is-active {
    background: rgb(46 91 255 / 0.22); color: #fff;
    box-shadow: 0 0 0 1px rgb(124 155 255 / 0.45), 0 6px 20px -6px rgb(46 91 255 / 0.7);
  }
  .admin-flash { margin-bottom: 1.5rem; border-radius: 0.75rem; padding: 0.75rem 1rem; font-weight: 500; }
  .admin-flash--ok { background: color-mix(in srgb, var(--success) 12%, var(--canvas)); color: var(--success); border: 1px solid color-mix(in srgb, var(--success) 35%, transparent); }
  .admin-flash--error { background: color-mix(in srgb, var(--danger) 10%, var(--canvas)); color: var(--danger); border: 1px solid color-mix(in srgb, var(--danger) 35%, transparent); }

  .admin-card { background: var(--canvas); border: 1px solid var(--line); border-radius: 1rem; padding: 1.25rem 1.5rem; }
  /* position: relative keeps visually hidden labels inside the scroll area. */
  .admin-table-wrap { position: relative; overflow-x: auto; background: var(--canvas); border: 1px solid var(--line); border-radius: 1rem; }
  .admin-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .admin-table th { text-align: left; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); padding: 0.75rem 1rem; border-bottom: 1px solid var(--line); background: var(--surface); white-space: nowrap; }
  .admin-table td { padding: 0.8rem 1rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .admin-table tr:last-child td { border-bottom: 0; }
  .admin-table tbody tr:hover { background: color-mix(in srgb, var(--accent) 4%, var(--canvas)); }
  .pill { display: inline-flex; align-items: center; gap: 0.35rem; border-radius: 999px; padding: 0.15rem 0.6rem; font-size: 0.78rem; font-weight: 600; white-space: nowrap; user-select: none; }
  .pill::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .pill--good { background: color-mix(in srgb, var(--success) 14%, var(--canvas)); color: var(--success); }
  .pill--warn { background: color-mix(in srgb, var(--warning) 16%, var(--canvas)); color: var(--warning); }
  .pill--bad { background: color-mix(in srgb, var(--danger) 14%, var(--canvas)); color: var(--danger); }
  .pill--info { background: var(--accent-soft); color: var(--accent); }
  .pill--muted { background: var(--mist); color: var(--muted); }
  .admin-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 40px; padding: 0 1rem; border-radius: 0.65rem; font-weight: 600; font-size: 0.92rem; border: 1px solid var(--line-strong); background: var(--canvas); color: var(--ink); transition: background-color 150ms, border-color 150ms; }
  .admin-btn:hover:not(:disabled) { background: var(--mist); }
  .admin-btn--primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .admin-btn--primary:hover:not(:disabled) { background: var(--accent-strong); }
  .admin-btn--danger { border-color: color-mix(in srgb, var(--danger) 50%, transparent); color: var(--danger); }
  .admin-btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .admin-input { width: 100%; min-height: 40px; border-radius: 0.6rem; border: 1px solid var(--line-strong); background: var(--canvas); color: var(--ink); padding: 0.45rem 0.7rem; font: inherit; }
  .admin-input:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
  .admin-label { display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 0.3rem; }
</style>
