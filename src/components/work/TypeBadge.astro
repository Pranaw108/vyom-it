---
// Every project shows exactly one of these, so concept work never passes as client work (FR-036).
interface Props {
  type: 'concept' | 'client';
}
const { type } = Astro.props;
---

{type === 'client' ? (
  <span class="badge bg-accent-soft text-accent">Client project</span>
) : (
  <span class="badge bg-cat-amber-soft text-cat-amber" title="A self-initiated project that shows our approach">Concept project</span>
)}

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    user-select: none;
  }
</style>
