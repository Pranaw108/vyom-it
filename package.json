{
  "name": "vyom-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types --strict-vars=false",
    "check": "astro check",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "vitest run",
    "test:api": "node scripts/api-smoke.mjs",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/pull-content.mjs",
    "seed:local": "node scripts/seed-content.mjs --local",
    "db:migrate:local": "wrangler d1 migrations apply vyom-website --local",
    "test:perf": "node scripts/perf-budget.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/preact": "^6.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "preact": "^11.0.1",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "lighthouse": "^13.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
