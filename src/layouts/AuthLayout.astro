---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Admin</title>
  </head>
  <body class="auth-bg grid min-h-dvh place-items-center px-[max(16px,env(safe-area-inset-left))] py-10">
    <main class="flex w-full max-w-md flex-col gap-6 rounded-2xl border border-line bg-canvas p-7 shadow-card sm:p-9">
      <a href="/" class="flex items-center gap-2.5 self-start font-display text-lg font-semibold" aria-label="Back to the website">
        <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#2e5bff" /><path d="M9 10.5 16 23l7-12.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /><circle cx="16" cy="9" r="2.4" fill="#ffb547" /></svg>
        Admin
      </a>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .auth-bg {
    background:
      radial-gradient(ellipse 70% 50% at 50% 110%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      var(--surface);
  }
  .auth-form { display: grid; gap: 1.1rem; }
  .auth-label { display: block; font-weight: 600; font-size: 0.92rem; margin-bottom: 0.35rem; }
  .auth-input {
    width: 100%; min-height: 48px; border-radius: 12px; border: 1px solid var(--line-strong);
    background: var(--canvas); color: var(--ink); padding: 0.65rem 0.85rem; font: inherit;
    transition: border-color 150ms, box-shadow 150ms;
  }
  .auth-input:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent); }
  .auth-input[aria-invalid='true'] { border-color: var(--danger); }
  .auth-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 50px; width: 100%;
    border-radius: 999px; font-weight: 600; background: var(--accent); color: var(--on-accent); transition: background-color 150ms;
  }
  .auth-btn:hover { background: var(--accent-strong); }
  .auth-btn--ghost { background: var(--canvas); color: var(--ink); border: 1px solid var(--line-strong); }
  .auth-btn--ghost:hover { background: var(--mist); }
  .auth-error { border-radius: 12px; padding: 0.75rem 1rem; background: color-mix(in srgb, var(--danger) 10%, var(--canvas)); color: var(--danger); font-weight: 500; border: 1px solid color-mix(in srgb, var(--danger) 35%, transparent); }
  .auth-note { border-radius: 12px; padding: 0.75rem 1rem; background: var(--mist); font-size: 0.92rem; }
  .auth-divider { display: flex; align-items: center; gap: 0.75rem; color: var(--muted); font-size: 0.85rem; }
  .auth-divider::before, .auth-divider::after { content: ''; flex: 1; height: 1px; background: var(--line); }
</style>
