---
import '../../styles/global.css';
import { env } from 'cloudflare:workers';

export const prerender = false;

const denied = Astro.locals.adminDenied;
const reason = denied?.reason ?? 'signed-out';
const googleReady = Boolean(env.GOOGLE_CLIENT_ID && env.GOOGLE_CLIENT_SECRET && env.SESSION_SECRET);

const messages = {
  'signed-out': { title: 'Sign in to the admin', body: 'This area is for the website team. Sign in with your work Google account.' },
  'no-access': { title: "You don't have access yet", body: 'You are signed in, but your account has not been added to the admin. Ask an Owner to add you.' },
  disabled: { title: 'Your access has been turned off', body: 'An Owner has disabled your admin account. Contact them if you think this is a mistake.' },
} as const;
const { title, body } = messages[reason];

// Why the last sign-in attempt did not finish (set by the Google callback).
const notices: Record<string, string> = {
  cancelled: 'Sign-in was cancelled. Try again when you are ready.',
  expired: 'That sign-in link expired or was already used. Please start again.',
  failed: 'Google could not confirm your sign-in. Please try again.',
  'not-configured': 'Google sign-in is not set up in this environment yet.',
  'signed-out': 'You have signed out.',
};
const notice = notices[Astro.url.searchParams.get('reason') ?? ''];
Astro.response.status = reason === 'signed-out' ? 401 : 403;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="grid min-h-dvh place-items-center bg-surface px-5">
    <main class="flex w-full max-w-md flex-col gap-5 rounded-2xl border border-line bg-canvas p-8 shadow-card">
      <svg width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#2e5bff" /><path d="M9 10.5 16 23l7-12.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /><circle cx="16" cy="9" r="2.4" fill="#ffb547" /></svg>
      <div class="flex flex-col gap-2">
        <h1 class="text-2xl font-semibold">{title}</h1>
        <p class="text-muted">{body}</p>
      </div>
      {notice && <p class="rounded-xl bg-mist px-4 py-3 text-sm" role="status">{notice}</p>}
      {denied?.email && <p class="text-sm text-muted">Signed in as <span class="font-medium text-ink">{denied.email}</span></p>}

      {reason === 'signed-out' && googleReady && (
        <a href="/auth/google/start" class="google-btn">
          <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" /><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" /><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" /><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" /></svg>
          Sign in with Google
        </a>
      )}
      {reason === 'signed-out' && !googleReady && <p class="text-sm text-muted">Admin sign-in is not set up in this environment yet.</p>}

      <div class="flex flex-wrap gap-4 border-t border-line pt-4 text-sm">
        <a href="/" class="font-medium text-accent underline underline-offset-4">Go to the website</a>
        {denied?.email && <a href="/auth/logout" class="font-medium text-muted underline underline-offset-4">Sign out</a>}
      </div>
    </main>
  </body>
</html>

<style>
  .google-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 48px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--canvas);
    font-weight: 600;
    transition: background-color 150ms, box-shadow 150ms;
  }
  .google-btn:hover { background: var(--mist); box-shadow: var(--shadow-card); }
</style>
