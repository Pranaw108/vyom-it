---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getCollection } from '../../../../lib/content/collections';
import { describeState } from '../../../../lib/content/status';
import { ContentStore } from '../../../../server/content/store';

export const prerender = false;

const admin = Astro.locals.admin!;
const def = getCollection(Astro.params.collection ?? '');
if (!def || !admin.can('content.view') || (def.name === 'team' && !admin.can('team.edit') && !admin.can('content.view'))) {
  return Astro.redirect('/admin/content?err=That%20content%20type%20is%20not%20available.');
}
if (def.kind === 'single') return Astro.redirect(`/admin/content/${def.name}/main`);

const entries = await new ContentStore(env.DB).list(def.name);
const canEdit = admin.can('content.edit') && admin.can(def.editPermission);
const canOrder = admin.can('content.publish') && admin.can(def.editPermission);
const fmt = (iso: string) => new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }).format(new Date(iso));
---

<AdminLayout title={def.label} intro={def.description}>
  <div slot="actions" class="flex gap-2">
    <a href="/admin/content" class="admin-btn">All content</a>
    {canEdit && <a href={`/admin/content/${def.name}/new`} class="admin-btn admin-btn--primary">Add new</a>}
  </div>

  <p class="admin-flash admin-flash--error" role="alert" data-order-status hidden></p>
  {entries.length === 0 ? (
    <p class="admin-card text-muted">Nothing here yet.{canEdit && ' Use “Add new” to create the first item.'}</p>
  ) : (
    <div class="admin-table-wrap">
      <table class="admin-table">
        <caption class="sr-only">{def.label}</caption>
        <thead><tr><th>Item</th><th>Status</th><th>Last change</th>{canOrder && <th>Order</th>}</tr></thead>
        <tbody>
          {entries.map((e, i) => {
            const state = describeState(e);
            return (
              <tr>
                <td><a href={`/admin/content/${def.name}/${e.key}`} class="font-medium text-accent">{def.titleOf(e.draft)}</a><span class="block font-mono text-xs text-muted">{e.key}</span></td>
                <td><span class:list={['pill', `pill--${state.tone}`]}>{state.label}</span></td>
                <td class="text-sm text-muted">{fmt(e.updatedAt)}{e.updatedBy && <span class="block text-xs">{e.updatedBy}</span>}</td>
                {canOrder && (
                  <td>
                    <span class="flex gap-1">
                      <button class="admin-btn" type="button" data-move="move-up" data-key={e.key} disabled={i === 0} aria-label={`Move ${def.titleOf(e.draft)} up`}>↑</button>
                      <button class="admin-btn" type="button" data-move="move-down" data-key={e.key} disabled={i === entries.length - 1} aria-label={`Move ${def.titleOf(e.draft)} down`}>↓</button>
                    </span>
                  </td>
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
  {canOrder && entries.length > 1 && <p class="mt-3 text-sm text-muted">Changing the order updates the live site straight away.</p>}
</AdminLayout>

<script define:vars={{ collection: def.name }}>
  const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') ?? '';
  const status = document.querySelector('[data-order-status]');
  document.querySelectorAll('[data-move]').forEach((button) => {
    button.addEventListener('click', async () => {
      button.disabled = true;
      const response = await fetch('/api/admin/content', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
        body: JSON.stringify({ action: button.dataset.move, collection, key: button.dataset.key }),
      });
      if (response.ok) location.reload();
      else {
        const data = await response.json().catch(() => ({}));
        if (status) {
          status.textContent = data.error ?? 'Could not change the order. Please try again.';
          status.hidden = false;
        }
        button.disabled = false;
      }
    });
  });
</script>
