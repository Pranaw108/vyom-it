---
import AuthLayout from '../../layouts/AuthLayout.astro';

export const prerender = false;

const denied = Astro.locals.adminDenied;
const reason = denied?.reason ?? 'signed-out';
if (reason === 'signed-out') return Astro.redirect('/auth/login');

const messages = {
  'no-access': { title: "You don't have access yet", body: 'You are signed in, but this account has not been added to the admin. Ask the site owner to add you.' },
  disabled: { title: 'Your access has been turned off', body: 'The site owner has disabled this account. Contact them if you think this is a mistake.' },
} as const;
const { title, body } = messages[reason];
Astro.response.status = 403;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<AuthLayout title={title}>
  <div class="flex flex-col gap-2">
    <h1 class="text-2xl font-semibold">{title}</h1>
    <p class="text-muted">{body}</p>
  </div>
  {denied?.email && <p class="text-sm text-muted">Signed in as <span class="font-medium text-ink">{denied.email}</span></p>}
  <div class="flex flex-col gap-3">
    <a href="/auth/logout" class="auth-btn auth-btn--ghost">Sign out and use another account</a>
    <a href="/" class="text-center text-sm font-medium text-accent underline underline-offset-4">Go to the website</a>
  </div>
</AuthLayout>
