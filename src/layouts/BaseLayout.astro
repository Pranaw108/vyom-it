---
import '../styles/global.css';
import Seo from '../components/seo/Seo.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  headerTone?: 'default' | 'night';
}

const { headerTone = 'default', ...seo } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Mark JS as available before first paint, so reveal effects never hide content without it. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b1324" />
    <Seo {...seo} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header tone={headerTone} />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    left: 1rem;
    top: -4rem;
    z-index: 60;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    transition: top 150ms;
  }
  .skip-link:focus { top: calc(1rem + env(safe-area-inset-top, 0px)); }
  main:focus { outline: none; }
</style>
