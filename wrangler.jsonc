{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "vyom-website",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["global_fetch_strictly_public"],
	// Custom entry adds the scheduled handler (email retries, retention) around Astro's handler.
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Non-secret settings. Secrets (TURNSTILE_SECRET, RESEND_API_KEY, IP_HASH_SALT, CSRF_SECRET,
	// INITIAL_OWNER_EMAIL, DEPLOY_HOOK_URL) are set with
	// `wrangler secret put` in production and in .dev.vars locally. See docs/ENVIRONMENT.md.
	"vars": {
		"SITE_URL": "http://localhost:4321",
		"COMPANY_NAME": "Vyom IT",
		"LEAD_NOTIFY_TO": "",
		"LEAD_ACK_ENABLED": "false",
		"LEAD_REPLY_TIME": "within 1 working day",
		"MAIL_FROM": "",
		// Cloudflare Access application protecting /admin (set when the client account exists).
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": ""
	},
	"r2_buckets": [
		{ "binding": "MEDIA", "bucket_name": "vyom-website-media" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vyom-website",
			// Preview database in the developer's account; replace when moving to the client's account.
			"database_id": "fb7e6f1d-bf3a-495c-a0b1-8a3f69b9fac0",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		// Every 15 minutes: retry lead emails. Daily at 03:00 UTC: retention clean-up.
		"crons": ["*/15 * * * *", "0 3 * * *"]
	}
}
